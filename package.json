{
  "name": "@lapxo/topos-measure",
  "version": "0.1.0",
  "private": true,
  "description": "A world of measurements built on topos: each quantity several origins read is one cell, said as where their readings meet or that they do not, and nothing is averaged.",
  "type": "module",
  "license": "MIT",
  "author": "Lapxo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapxo/topos-measure.git"
  },
  "keywords": [
    "topos",
    "world",
    "measurement",
    "readings"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TARGET.bound"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@lapxo/obligations": "^0.3.5",
    "@lapxo/topos": "0.1.2"
  }
}
